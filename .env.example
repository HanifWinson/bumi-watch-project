# ─── Elastic Cloud ───────────────────────────────────────────
ELASTIC_URL=https://your-deployment.es.us-central1.gcp.cloud.es.io
ELASTIC_API_KEY=your_elastic_api_key_here

# ─── NASA FIRMS ──────────────────────────────────────────────
NASA_FIRMS_API_KEY=your_nasa_firms_key_here
# Get free key at: https://firms.modaps.eosdis.nasa.gov/api/area/

# ─── OpenAQ ──────────────────────────────────────────────────
OPENAQ_API_KEY=your_openaq_key_here
# Get free key at: https://docs.openaq.org/

# ─── BMKG (no key needed — public API) ───────────────────────
# https://data.bmkg.go.id/

# ─── Global Forest Watch ─────────────────────────────────────
GFW_API_KEY=your_gfw_key_here
# Get free key at: https://www.globalforestwatch.org/

# ─── Pipeline settings ───────────────────────────────────────
PIPELINE_INTERVAL_MINUTES=30
LOG_LEVEL=info
